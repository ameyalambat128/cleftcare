{
  "name": "cleftcare",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "prebuild": "EXPO_NO_GIT_STATUS=1 expo prebuild",
    "prebuild:ios": "EXPO_NO_GIT_STATUS=1 expo prebuild --platform ios",
    "prebuild:android": "EXPO_NO_GIT_STATUS=1 expo prebuild --platform android",
    "start": "expo start --dev-client",
    "start:prod": "expo start --dev-client --no-dev --minify",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "bun run lint",
    "lint": "tsc --noEmit && bunx prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "bunx prettier \"**/*.{js,jsx,ts,tsx,json}\" --write"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.668.0",
    "@babel/runtime": "^7.28.4",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^7.0.14",
    "@types/uuid": "^10.0.0",
    "axios": "^1.7.7",
    "buffer": "^6.0.3",
    "expo": "^55.0.0",
    "expo-asset": "~55.0.15",
    "expo-audio": "~55.0.13",
    "expo-build-properties": "~55.0.13",
    "expo-constants": "~55.0.14",
    "expo-crypto": "~55.0.14",
    "expo-dev-client": "~55.0.27",
    "expo-file-system": "~55.0.16",
    "expo-font": "~55.0.6",
    "expo-image-picker": "~55.0.18",
    "expo-linking": "~55.0.13",
    "expo-localization": "~55.0.13",
    "expo-router": "~55.0.12",
    "expo-splash-screen": "~55.0.18",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.15",
    "expo-web-browser": "~55.0.14",
    "i18next": "^25.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^15.1.3",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-signature-canvas": "^4.7.2",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.2",
    "uuid": "^10.0.0",
    "zustand": "^5.0.0-rc.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-transform-class-static-block": "^7.28.3",
    "@expo/metro-runtime": "~55.0.9",
    "@types/react": "~19.2.10",
    "jest": "^29.2.1",
    "jest-expo": "~55.0.16",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
